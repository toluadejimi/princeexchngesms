APP_NAME=PrinnceVerify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: run `npm ci && npm run build` and ensure public/build is deployed.
# Never deploy `public/hot` (from `npm run dev`) — it makes CSS load from [::1]:5174 and breaks styling.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Log SMS/API provider requests to storage/logs/laravel.log (failures always; successes when true)
LOG_API_REQUESTS=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset & notifications: use "smtp" (or sendmail/postmark/etc.). "log" only writes to storage/logs — no real email.
# Production: many hosts block outbound SMTP to third-party servers (e.g. mail.privateemail.com:465 → "Connection refused").
# Fix: use your host's SMTP relay (often mail.yourdomain.com), MAIL_MAILER=sendmail, or a transactional API (Mailgun/Postmark/SES/Resend).
# If 465 is blocked, try port 587 with MAIL_SCHEME=smtp (STARTTLS) per your provider's docs.
MAIL_MAILER=smtp
# Optional override; if null, Laravel uses smtps on port 465 and smtp on other ports.
MAIL_SCHEME=null
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS upstream (keys also editable in Admin → Servers; encrypted in DB)
# Customer Server 1 (slot getatext): header Auth
GETATEXT_API_KEY=
GETATEXT_BASE_URL=https://getatext.com
# If /api/v1/prices-info hits cURL 28, increase (seconds)
GETATEXT_HTTP_TIMEOUT=60
GETATEXT_HTTP_CONNECT_TIMEOUT=25
# Customer Server 2 (slot multi_country)
GLOBAL_SMS_API_KEY=
# If api.smspool.net is slow/unreachable, these control request/connect limits (seconds).
SMSPOOL_HTTP_TIMEOUT=30
SMSPOOL_HTTP_CONNECT_TIMEOUT=10
# Customer Server 3 (slot fivesim): Authorization Bearer
FIVESIM_API_KEY=
FIVESIM_BASE_URL=https://5sim.net

# SprintPay (wallet funding: virtual account + instant pay URL)
SPRINTPAY_KEY=
# Register webhook in SprintPay dashboard: POST https://yourdomain.com/webhook/sprintpay
